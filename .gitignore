# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# Secrets
.env
kaggle.json

# Data: raw and generated files stay local / on Kaggle (only small gold + samples are committed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
# our own synthetic reports are committed (CC BY 4.0) so the pipeline can be rebuilt
!data/raw/synthetic/
!data/processed/.gitkeep

# Voice recordings of teammates are personal data: never commit them
data/audio/*
!data/audio/.gitkeep

# Model weights (download from Kaggle outputs instead)
models/*
!models/.gitkeep
*.pt
*.bin
*.safetensors
*.ckpt

# Caches
.cache/
geocode_cache.json
wandb/

# OS / editors
.DS_Store
.vscode/
.idea/

# Teammates prediction CSVs (scored by scripts/evaluate.py)
predictions/

# API runtime logs and local Streamlit output
reports/alerts.jsonl
reports/corrections.jsonl
output/
.archify/
.impeccable/review/
.impeccable/*.local.json
certs/

# gold set: only our labels are published; tweet text is rebuilt locally by scripts/rehydrate_gold.py
data/gold/*
!data/gold/.gitkeep
!data/gold/gold_labels.csv
!data/gold/gold_audit_labels.csv

# release artefacts
dist/
