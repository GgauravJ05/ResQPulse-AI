  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one acting control in a group (Analyze Report, Dispatch): a black pill.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Dispatch</button>",
      "css": "@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'); .ds-btn{font-family:'Figtree',-apple-system,sans-serif;font-weight:600;font-size:0.93rem;border-radius:999px;padding:0.5rem 1.15rem;border:1px solid #D4D4D0;background:#FFFFFF;color:#141414;cursor:pointer;transition:background 0.2s cubic-bezier(0.22,1,0.36,1),border-color 0.2s cubic-bezier(0.22,1,0.36,1);box-shadow:none;} .ds-btn:hover{border-color:#141414;} .ds-btn:focus-visible{outline:2px solid #141414;outline-offset:2px;} .ds-btn:disabled{color:#A3A3A0;border-color:#E4E4E1;background:#FAFAF9;cursor:default;} .ds-btn-primary{background:#141414;color:#FFFFFF;border-color:#141414;} .ds-btn-primary:hover{background:#2E2E2E;border-color:#141414;} .ds-btn-primary:disabled{background:#B8B8B4;border-color:#B8B8B4;color:#FFFFFF;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every other action: white pill with a strong hairline that turns ink on hover.",
      "html": "<button class=\"ds-btn\">Confirm</button> <button class=\"ds-btn\" disabled>Dismiss</button>",
      "css": "@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'); .ds-btn{font-family:'Figtree',-apple-system,sans-serif;font-weight:600;font-size:0.93rem;border-radius:999px;padding:0.5rem 1.15rem;border:1px solid #D4D4D0;background:#FFFFFF;color:#141414;cursor:pointer;transition:background 0.2s cubic-bezier(0.22,1,0.36,1),border-color 0.2s cubic-bezier(0.22,1,0.36,1);box-shadow:none;} .ds-btn:hover{border-color:#141414;} .ds-btn:focus-visible{outline:2px solid #141414;outline-offset:2px;} .ds-btn:disabled{color:#A3A3A0;border-color:#E4E4E1;background:#FAFAF9;cursor:default;} "
    },
    {
      "name": "Queue Action Group",
      "kind": "custom",
      "refersTo": "button-primary",
      "description": "Horizontal button group under each queue row, small gap, Dispatch the only black pill.",
      "html": "<div class=\"ds-actions\"><button class=\"ds-btn\">Confirm</button><button class=\"ds-btn ds-btn-primary\">Dispatch</button><button class=\"ds-btn\">Dismiss</button><button class=\"ds-btn\">Open alert</button></div>",
      "css": "@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'); .ds-btn{font-family:'Figtree',-apple-system,sans-serif;font-weight:600;font-size:0.93rem;border-radius:999px;padding:0.5rem 1.15rem;border:1px solid #D4D4D0;background:#FFFFFF;color:#141414;cursor:pointer;transition:background 0.2s cubic-bezier(0.22,1,0.36,1),border-color 0.2s cubic-bezier(0.22,1,0.36,1);box-shadow:none;} .ds-btn:hover{border-color:#141414;} .ds-btn:focus-visible{outline:2px solid #141414;outline-offset:2px;} .ds-btn:disabled{color:#A3A3A0;border-color:#E4E4E1;background:#FAFAF9;cursor:default;} .ds-actions{display:flex;gap:0.5rem;flex-wrap:wrap;background:#F5F5F3;padding:0.6rem;} .ds-btn-primary{background:#141414;color:#FFFFFF;border-color:#141414;} .ds-btn-primary:hover{background:#2E2E2E;}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "White field, strong hairline, 12px radius, ink border on focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Report text</span><textarea class=\"ds-input\" rows=\"3\">Truck hit two cars near Lonavala exit; road blocked.</textarea></label>",
      "css": "@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'); .ds-field{display:block;font-family:'Figtree',-apple-system,sans-serif;max-width:420px;} .ds-field-label{display:block;font-size:0.88rem;font-weight:600;color:#141414;margin-bottom:0.4rem;} .ds-input{width:100%;font:inherit;font-size:1rem;color:#141414;background:#FFFFFF;border:1px solid #D4D4D0;border-radius:12px;padding:0.7rem 0.85rem;resize:vertical;transition:border-color 0.2s cubic-bezier(0.22,1,0.36,1);} .ds-input:focus{outline:none;border-color:#141414;}"
    },
    {
      "name": "Left Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Kaggle-style plain-text rail; hover wash, signal-tint active row.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-nav\" href=\"#\">Report Input</a><a class=\"ds-nav ds-nav-active\" href=\"#\" aria-current=\"page\">Alert Card</a><a class=\"ds-nav\" href=\"#\">Attention Heatmap</a><a class=\"ds-nav\" href=\"#\">Dispatcher Dashboard</a></nav>",
      "css": "@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'); .ds-rail{display:flex;flex-direction:column;gap:2px;width:240px;background:#FFFFFF;border-right:1px solid #E4E4E1;padding:0.6rem;font-family:'Figtree',-apple-system,sans-serif;} .ds-nav{display:block;padding:0.62rem 0.9rem;border-radius:12px;font-size:0.97rem;font-weight:500;color:#4D4D4D;text-decoration:none;transition:background 0.2s cubic-bezier(0.22,1,0.36,1);} .ds-nav:hover{background:#F2F2F0;} .ds-nav:focus-visible{outline:2px solid #141414;outline-offset:2px;} .ds-nav-active,.ds-nav-active:hover{background:#FFF4CC;color:#141414;font-weight:600;}"
    },
    {
      "name": "Severity Pill and Status Tag",
      "kind": "chip",
      "refersTo": "severity-pill",
      "description": "Filled mono severity pill beside an outlined mono status tag.",
      "html": "<span class=\"ds-sev\" style=\"background:#D92D20;color:#FFFFFF\">CRITICAL 4.4</span> <span class=\"ds-sev\" style=\"background:#F5B301;color:#141414\">MEDIUM</span> <span class=\"ds-status\">NEW</span>",
      "css": "@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'); .ds-sev,.ds-status{display:inline-flex;align-items:center;border-radius:999px;font-family:'JetBrains Mono',ui-monospace,monospace;text-transform:uppercase;white-space:nowrap;} .ds-sev{padding:0.38rem 0.9rem;font-size:0.74rem;font-weight:600;letter-spacing:0.08em;} .ds-status{padding:0.32rem 0.75rem;font-size:0.7rem;letter-spacing:0.08em;color:#4D4D4D;background:#FFFFFF;border:1px solid #D4D4D0;}"
    },
    {
      "name": "Live Status Pill",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Top-bar mono pill; the yellow dot pulses when real models answer.",
      "html": "<span class=\"ds-live\"><span class=\"ds-dot\"></span>Live · real models</span>",
      "css": "@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'); .ds-live{display:inline-flex;align-items:center;gap:0.5rem;padding:0.38rem 0.85rem;border-radius:999px;background:#FFFFFF;border:1px solid #D4D4D0;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;color:#141414;} .ds-dot{width:8px;height:8px;border-radius:50%;background:#FFCC00;animation:ds-live 2.2s cubic-bezier(0.22,1,0.36,1) infinite;} @keyframes ds-live{0%{box-shadow:0 0 0 0 rgba(255,204,0,0.7);}70%{box-shadow:0 0 0 8px rgba(255,204,0,0);}100%{box-shadow:0 0 0 0 rgba(255,204,0,0);}} @media (prefers-reduced-motion: reduce){.ds-dot{animation:none;}}"
    },
    {
      "name": "Severity Ruler",
      "kind": "custom",
      "refersTo": "panel",
      "description": "The signature: five track cells filled to a continuous 1-5 score, value in mono.",
      "html": "<div class=\"ds-ruler\" role=\"img\" aria-label=\"Severity 3.4 of 5\"><div class=\"ds-cells\"><span><i style=\"width:100%\"></i></span><span><i style=\"width:100%\"></i></span><span><i style=\"width:100%\"></i></span><span><i style=\"width:40%\"></i></span><span><i style=\"width:0%\"></i></span></div><div class=\"ds-val\">3.4<span> / 5</span></div></div>",
      "css": "@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'); .ds-ruler{display:flex;align-items:center;gap:0.9rem;max-width:520px;} .ds-cells{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;flex:1;max-width:420px;} .ds-cells span{height:12px;border-radius:3px;background:#ECECE9;position:relative;overflow:hidden;} .ds-cells i{position:absolute;inset:0 auto 0 0;display:block;background:#E8590C;} .ds-val{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:0.9rem;font-weight:600;color:#141414;font-variant-numeric:tabular-nums;white-space:nowrap;} .ds-val span{color:#6B6B68;font-weight:400;}"
    },
    {
      "name": "Queue Row",
      "kind": "card",
      "refersTo": "queue-row",
      "description": "One alert in the queue: title, mono ID, location, mini ruler, pill, status, summary.",
      "html": "<div class=\"ds-q\"><div class=\"ds-q-top\"><div><span class=\"ds-q-title\">Transport Accident</span><span class=\"ds-q-id\">RQP-000003</span><div class=\"ds-q-loc\">km 112 of Kolhapur-Pune highway</div></div><div class=\"ds-q-right\"><span class=\"ds-mini\"><b style=\"--f:100%\"></b><b style=\"--f:100%\"></b><b style=\"--f:100%\"></b><b style=\"--f:100%\"></b><b style=\"--f:70%\"></b></span><span class=\"ds-mono\">4.7 / 5</span><span class=\"ds-sev\">CRITICAL</span></div></div><div class=\"ds-q-sum\">Road accident victim with bleeding from nose and ears; unresponsive.</div></div>",
      "css": "@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'); .ds-q{font-family:'Figtree',-apple-system,sans-serif;background:#FFFFFF;border:1px solid #E4E4E1;border-radius:14px;padding:1.05rem 1.25rem;transition:border-color 0.2s cubic-bezier(0.22,1,0.36,1);} .ds-q:hover{border-color:#D4D4D0;} .ds-q-top{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;} .ds-q-title{font-size:1.05rem;font-weight:600;color:#141414;} .ds-q-id,.ds-mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:0.74rem;color:#6B6B68;letter-spacing:0.04em;margin-left:0.6rem;} .ds-q-loc{font-size:0.9rem;color:#6B6B68;margin-top:0.15rem;} .ds-q-sum{font-size:0.97rem;color:#4D4D4D;margin-top:0.6rem;} .ds-q-right{display:flex;align-items:center;gap:0.5rem;} .ds-mini{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;width:110px;} .ds-mini b{height:7px;border-radius:2px;background:linear-gradient(90deg,#D92D20 var(--f),#ECECE9 var(--f));} .ds-sev{border-radius:999px;padding:0.38rem 0.9rem;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:0.74rem;font-weight:600;letter-spacing:0.08em;background:#D92D20;color:#FFFFFF;}"
