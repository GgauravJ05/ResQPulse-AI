  "narrative": {
    "northStar": "The Competition Page",
    "overview": "ResQPulse is a dispatcher console with the evaluation-grade calm of a Kaggle competition page. A light grey ground carries white panels drawn with single hairlines; nothing floats, nothing glows. Black pill buttons do the acting, one signal yellow marks what is live, current or under attention, and every other colour on screen is a severity colour that means severity. The world is built for a projector in a lit hall as much as for a dispatcher's desk, so contrast stays high and ornament stays out.\n\nHierarchy comes from type weight, size and position rather than colour. Figtree sets everything a person reads; JetBrains Mono, small, uppercase and tracked, is reserved for machine facts: IDs, coordinates, scores, field labels and the live status. The signature is the severity ruler, five segmented cells filled to a continuous score with the value beside it in mono, repeated at full size on the alert and in miniature on every queue row.\n\nThe system rejects the dark command-centre cockpit, emoji tiles, gradient mastheads and the cream-and-italic-serif editorial look the previous build used.",
    "keyCharacteristics": [
      "Light grey ground, white surfaces, 1px hairlines, no elevation shadows.",
      "Black pill buttons; one signal yellow for live state, active navigation, selection and attention.",
      "Severity colours appear only where they encode severity.",
      "Figtree for reading, JetBrains Mono only for machine facts.",
      "The five-cell severity ruler as the recurring signature.",
      "Words, never pictograms or emoji."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Signal yellow marks live state, the active place, selection and model attention. It is never a button, a heading colour or decoration; if a screen has yellow, the yellow means \"this is live, current, or what the model looked at\".",
        "section": "colors"
      },
      {
        "name": "The Severity Means Severity Rule",
        "body": "The five severity colours appear only on severity pills, ruler fills, map markers and the injury/hazard dots. A green success or a red error that is not a severity is not drawn in the severity palette.",
        "section": "colors"
      },
      {
        "name": "The Machine Voice Rule",
        "body": "Mono is only for things a machine produced or keys on: IDs, coordinates, scores, field and metric labels, status. A sentence a person reads is never set in mono.",
        "section": "typography"
      },
      {
        "name": "The Tabular Number Rule",
        "body": "Every number that can change between alerts (scores, counts, percentages, latencies) uses tabular figures so values do not jitter across rows.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Surfaces separate by a 1px hairline and a change of tone, never by a drop shadow. Hover strengthens a border (hair to hair-2, or to ink on buttons); it does not lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** put content in white panels with a 1px hair border on the ground; separate meta rows with hairlines.",
      "**Do** make the single most consequential action in a group the only black pill (Analyze Report, Dispatch).",
      "**Do** use the severity ruler wherever a severity score is shown, full size on detail views and mini in lists.",
      "**Do** set IDs, coordinates, scores and field labels in small uppercase tracked JetBrains Mono, and everything a person reads in Figtree.",
      "**Do** use tabular figures for every changing number.",
      "**Do** keep disabled controls at full opacity with a lighter label, so they stay readable on a projector.",
      "**Do** stop the live pulse under prefers-reduced-motion."
    ],
    "donts": [
      "**Don't** add drop shadows or lift on hover; depth is tone and hairline.",
      "**Don't** use signal yellow as a button, heading or decorative fill.",
      "**Don't** use severity colours for anything that is not severity.",
      "**Don't** use emoji or pictogram icons for incident types or responders; name them in words.",
      "**Don't** go dark, add gradient mastheads, or bring back cream grounds with italic serif display type."
    ]
  }
}