# Copy to .env and fill in. Never commit .env.

# Claude API key for generating synthetic reports (ML1). See docs/SCHEMA.md §3.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Backend URL the Streamlit app calls
API_URL=http://localhost:8000

# Paths to trained models (downloaded from Kaggle outputs)
CLASSIFIER_DIR=models/classifier
GENERATOR_DIR=models/generator
WHISPER_MODEL=small.en
