# Copy to .env and fill in. Never commit .env.

# Backend URL the Streamlit app calls
API_URL=http://localhost:8000

# Paths to trained models (downloaded from Kaggle outputs)
CLASSIFIER_DIR=models/classifier
GENERATOR_DIR=models/generator
WHISPER_MODEL=small.en

# Backend: true = fake models (works with no weights); false = real ML2/ML3/Whisper models from the folders above
USE_FAKE_MODELS=true
